{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/questoes.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/ensino-medio/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/corrigir-em",
      "destination": "https://painel-prova-paulista-2026.vercel.app/api/corrigir-em"
    },
    {
      "source": "/api/alunos-em",
      "destination": "https://painel-prova-paulista-2026.vercel.app/api/alunos-em"
    },
    {
      "source": "/api/individual",
      "destination": "https://painel-prova-paulista-2026.vercel.app/api/individual"
    },
    {
      "source": "/api/personalizada-em",
      "destination": "https://painel-prova-paulista-2026.vercel.app/api/personalizada-em"
    },
    {
      "source": "/api/aluno-login",
      "destination": "https://painel-prova-paulista-2026.vercel.app/api/aluno-login"
    },
    {
      "source": "/aluno-acesso.js",
      "destination": "https://painel-prova-paulista-2026.vercel.app/aluno-acesso.js"
    },
    {
      "source": "/sinais.js",
      "destination": "https://painel-prova-paulista-2026.vercel.app/sinais.js"
    },
    {
      "source": "/voltar-painel.js",
      "destination": "https://painel-prova-paulista-2026.vercel.app/voltar-painel.js"
    }
  ]
}
