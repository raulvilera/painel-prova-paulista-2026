/* Catálogo das atividades de recomposição (gerado a partir do painel: ATIV + GUIA, 6º ao 9º ano). */
const RECOMP_CAT = {"6º ANO|1|Relacionar o movimento de rotação terrestre com a ocorrência da sucessão dia e noite.":{"serie":"6","bim":"1","desc":"Relacionar o movimento de rotação terrestre com a ocorrência da sucessão dia e noite.","hab":"EF06CI14","habTxt":"Explicar fenômenos causados pelos movimentos do sistema Terra-Sol-Lua: dia/noite, estações, fases da Lua e eclipses (AE2).","nome":"Lanterna e a laranja que gira","concreta":"Com a sala escura, a lanterna (Sol) fica parada e um aluno gira a laranja espetada no palito, com um adesivo no Brasil; a turma observa quando o adesivo passa pela parte iluminada (dia) e pela escura (noite).","ab":"Tirinha de 4 quadros: desenhar o adesivo em posições diferentes da rotação e escrever 'dia' ou 'noite', com legenda guiada pelo professor.","b":"Em duplas com monitor, resolver itens comparando rotação (cerca de 24 h, dia e noite) e translação (cerca de 1 ano) e justificar por que cada alternativa errada está incorreta.","item":{"enunciado":"Lucas, em São Paulo, fez uma chamada de vídeo às 20h com a prima que mora no Japão, onde já era manhã do dia seguinte. Ser noite em um lugar e dia em outro ao mesmo tempo acontece porque:","alternativas":["A) a Terra completa a translação ao redor do Sol a cada 24 horas.","B) a Terra gira em torno do próprio eixo, e só metade do planeta fica iluminada pelo Sol de cada vez.","C) o Sol gira ao redor da Terra uma vez por dia.","D) a Lua bloqueia a luz do Sol em parte do planeta."],"gabarito":"B"}},"6º ANO|1|Reconhecer os efeitos da gravidade na organização do Sistema Solar e em fenômenos observáveis no cotidiano.":{"serie":"6","bim":"1","desc":"Reconhecer os efeitos da gravidade na organização do Sistema Solar e em fenômenos observáveis no cotidiano.","hab":"EF06CI13, EF06CI14","habTxt":"Explicar fenômenos causados pelos movimentos do sistema Terra-Sol-Lua: dia/noite, estações, fases da Lua e eclipses (AE2).","nome":"Quem puxa tudo?","concreta":"Soltar ao mesmo tempo uma folha aberta e uma amassada; depois girar a meia presa ao barbante: o barbante faz o papel da gravidade do Sol segurando o planeta em órbita. Ao soltar o barbante, a meia sai pela tangente.","ab":"Tabela com 6 figuras (fruta caindo, chuva, pulo, maré, Lua ao redor da Terra, planeta ao redor do Sol): marcar onde a gravidade age e completar 'A gravidade é a força que…'.","b":"Situações-problema em duplas: por que o peso do astronauta diminui na Lua e por que os planetas não 'fogem' do Sol; itens com justificativa das alternativas.","item":{"enunciado":"Os planetas do Sistema Solar giram ao redor do Sol há bilhões de anos sem se afastar dele. Isso acontece principalmente porque:","alternativas":["A) a luz do Sol empurra os planetas para perto dele.","B) existe ar no espaço que segura os planetas.","C) a força gravitacional do Sol atrai os planetas, mantendo-os em órbita.","D) os planetas estão amarrados ao Sol por ímãs gigantes."],"gabarito":"C"}},"6º ANO|1|Analisar as interações entre Sol, Terra e Lua na ocorrência das fases da Lua, dos eclipses e na medição do tempo.":{"serie":"6","bim":"1","desc":"Analisar as interações entre Sol, Terra e Lua na ocorrência das fases da Lua, dos eclipses e na medição do tempo.","hab":"EF06CI14","habTxt":"Explicar fenômenos causados pelos movimentos do sistema Terra-Sol-Lua: dia/noite, estações, fases da Lua e eclipses (AE2).","nome":"Lua no palito","concreta":"Cada aluno segura a 'Lua' com o braço esticado e gira devagar diante da lanterna, vendo a parte iluminada mudar (nova, crescente, cheia, minguante). Depois alinham lanterna-Lua-cabeça (eclipse solar) e lanterna-cabeça-Lua (eclipse lunar).","ab":"Ordenar os cartões das 4 fases em um círculo guiado e desenhar, em tabela, a ordem dos astros em cada tipo de eclipse.","b":"Analisar esquemas de eclipses e um calendário lunar (cerca de 29,5 dias por ciclo) e resolver itens sobre a ordem dos astros e a fase da Lua em cada eclipse.","item":{"enunciado":"Em uma noite de lua cheia, a sombra da Terra foi cobrindo a Lua, que ficou avermelhada no céu. Esse fenômeno e a ordem dos astros são, respectivamente:","alternativas":["A) eclipse lunar; Sol – Terra – Lua.","B) eclipse solar; Sol – Lua – Terra.","C) eclipse lunar; Sol – Lua – Terra.","D) eclipse solar; Sol – Terra – Lua."],"gabarito":"A"}},"6º ANO|1|Relacionar as estações do ano como consequência da inclinação do eixo terrestre e do movimento de translação da Terra ao redor do Sol.":{"serie":"6","bim":"1","desc":"Relacionar as estações do ano como consequência da inclinação do eixo terrestre e do movimento de translação da Terra ao redor do Sol.","hab":"EF06CI14","habTxt":"Explicar fenômenos causados pelos movimentos do sistema Terra-Sol-Lua: dia/noite, estações, fases da Lua e eclipses (AE2).","nome":"Terra inclinada em volta da lanterna","concreta":"Lanterna fixa no centro; um aluno leva a 'Terra' inclinada ao redor dela, com o palito sempre apontando para a mesma parede. A turma observa que ora o hemisfério sul, ora o norte recebe luz mais direta.","ab":"Completar dois desenhos guiados (dezembro e junho), marcando qual hemisfério recebe luz mais direta e qual é a estação no Brasil.","b":"Ler tabela de temperaturas médias de dezembro e junho em São Paulo e Lisboa e explicar, pela inclinação do eixo e translação, por que as estações são opostas; refutar 'verão = mais perto do Sol'.","item":{"enunciado":"Em dezembro é verão no Brasil e inverno em Portugal. Um aluno afirmou que isso ocorre porque a Terra está mais perto do Sol em dezembro. A explicação correta é:","alternativas":["A) a rotação da Terra deixa um hemisfério mais tempo no escuro durante o ano todo.","B) a distância entre a Terra e o Sol muda muito e o Brasil fica mais perto dele.","C) a Lua bloqueia a luz do Sol no hemisfério norte em dezembro.","D) a inclinação do eixo da Terra, durante a translação, faz cada hemisfério receber luz mais direta em épocas diferentes."],"gabarito":"D"}},"6º ANO|1|Reconhecer a formação e transformação da Terra ao longo do tempo.":{"serie":"6","bim":"1","desc":"Reconhecer a formação e transformação da Terra ao longo do tempo.","hab":"EF06CI11, EF06CI13","habTxt":"Descrever as esferas da Terra (litosfera, hidrosfera, atmosfera, biosfera), o surgimento da litosfera e suas transformações no tempo (AE1).","nome":"Linha do tempo no barbante","concreta":"Esticar 4,6 m de barbante (1 m = 1 bilhão de anos) e prender cartões: formação da Terra, oceanos, primeiros seres vivos, oxigênio no ar, dinossauros (extintos a 6,6 cm do fim) e humanos (a menos de 1 mm do fim).","ab":"Com imagens da Terra primitiva e atual, completar tabela 'antes/agora' (atmosfera, superfície, vida) usando um banco de palavras.","b":"Calcular a posição de eventos na escala e interpretar a linha (quanto do tempo houve humanos, dinossauros); itens sobre mudanças na atmosfera e na crosta.","item":{"enunciado":"Numa linha do tempo de 4,6 metros que representa a história da Terra (1 m = 1 bilhão de anos), o surgimento dos seres humanos fica a menos de 1 milímetro do final. Isso indica que:","alternativas":["A) os humanos surgiram junto com a formação da Terra.","B) a Terra se formou há apenas alguns milhares de anos.","C) os humanos conviveram com os dinossauros.","D) os seres humanos existem há um tempo muito curto em comparação com a idade da Terra."],"gabarito":"D"}},"6º ANO|1|Classificar os corpos celestes do Sistema Solar.":{"serie":"6","bim":"1","desc":"Classificar os corpos celestes do Sistema Solar.","hab":"EF06CI11","habTxt":"Descrever as esferas da Terra (litosfera, hidrosfera, atmosfera, biosfera), o surgimento da litosfera e suas transformações no tempo (AE1).","nome":"Detetives do céu","concreta":"Em roda, o professor mostra cartas-imagem e lê pistas ('tem luz própria', 'gira ao redor de um planeta', 'forma cauda perto do Sol'); a turma separa as cartas em pilhas: estrela, planeta, satélite, cometa, asteroide.","ab":"Completar tabela-guia com 3 colunas para cada tipo (tem luz própria? gira em torno de quê? exemplo) usando as cartas.","b":"Jogo 'Quem sou eu?' em duplas com monitor e itens diferenciando estrela, planeta, satélite natural, cometa e asteroide, justificando as erradas.","item":{"enunciado":"Um corpo celeste formado por gelo e poeira gira ao redor do Sol em uma órbita alongada. Quando se aproxima do Sol, forma uma longa cauda brilhante. Esse corpo celeste é classificado como:","alternativas":["A) estrela.","B) cometa.","C) satélite natural.","D) planeta."],"gabarito":"B"}},"6º ANO|3|Reconhecer os princípios da teoria celular.":{"serie":"6","bim":"3","desc":"Reconhecer os princípios da teoria celular.","hab":"EF06CI05","habTxt":"Analisar a organização básica da célula como unidade estrutural e funcional de seres uni e pluricelulares (AE5).","nome":"Célula no saquinho","concreta":"Montar a célula no saquinho (membrana, citoplasma, núcleo) e compará-la com imagens de células de cebola, da pele e de uma bactéria: todos os seres vivos são formados por células.","ab":"Separar cartões-imagem em 'ser vivo: formado por células' e 'não vivo' (pedra, cadeira) e completar os 3 postulados com lacunas guiadas.","b":"Julgar afirmações V/F sobre os postulados (ex.: 'células surgem do nada'), corrigindo as falsas, e resolver itens em duplas com monitor.","item":{"enunciado":"Um estudante observou ao microscópio uma folha de elódea, a película da cebola e uma gota de água de lago com paramécios. Em todos encontrou células. Essa observação apoia o princípio da teoria celular segundo o qual:","alternativas":["A) todos os seres vivos são formados por uma ou mais células.","B) apenas as plantas são formadas por células.","C) as células surgem espontaneamente na água.","D) somente seres grandes possuem células."],"gabarito":"A"}},"6º ANO|2|Classificar os diferentes tipos de rochas e os processos de formação do solo.":{"serie":"6","bim":"2","desc":"Classificar os diferentes tipos de rochas e os processos de formação do solo.","hab":"EF06CI12","habTxt":"Classificar rochas, seus processos de formação e a formação/transformação do solo, incluindo a fossilização em rochas sedimentares (AE3).","nome":"Rochas e o pote de camadas","concreta":"Agitar o pote com terra, areia, pedrinhas e água e deixar decantar: formam-se camadas, como nos sedimentos que originam rochas sedimentares. Passar de mão em mão amostras de granito/brita, arenito e mármore/ardósia.","ab":"Classificar amostras ou fotos em tabela de 3 colunas (magmática: magma resfriado; sedimentar: camadas de sedimentos; metamórfica: transformada por calor e pressão) e desenhar as camadas do pote.","b":"Montar em duplas o esquema do ciclo das rochas e da formação do solo (rocha-mãe → intemperismo → solo) e resolver itens com justificativa.","item":{"enunciado":"Ao agitar um pote com água, terra, areia e pedrinhas e deixá-lo em repouso, formam-se camadas: pedrinhas no fundo, areia no meio e argila em cima. Na natureza, a compactação de camadas como essas ao longo de milhões de anos forma rochas:","alternativas":["A) magmáticas.","B) metamórficas.","C) sedimentares.","D) vulcânicas."],"gabarito":"C"}},"6º ANO|3|Classificar células procariontes e eucariontes de acordo com a presença ou ausência de núcleo organizado.":{"serie":"6","bim":"3","desc":"Classificar células procariontes e eucariontes de acordo com a presença ou ausência de núcleo organizado.","hab":"EF06CI05","habTxt":"Analisar a organização básica da célula como unidade estrutural e funcional de seres uni e pluricelulares (AE5).","nome":"Com ou sem envoltório?","concreta":"Montar dois saquinhos-célula: em um, o barbante fica solto no citoplasma (procarionte); no outro, fica dentro de um saquinho menor (núcleo com envoltório, eucarionte). Comparar com esquemas de bactéria e de célula animal.","ab":"Classificar 8 imagens (bactéria, cianobactéria, ameba, fungo, célula de cebola, célula humana…) em tabela 'tem núcleo? sim/não' → procarionte/eucarionte, com mediação.","b":"Preencher quadro-síntese com exemplos de cada tipo e resolver itens que descrevem uma célula para classificar, justificando as alternativas.","item":{"enunciado":"Ao analisar uma célula, um pesquisador verificou que o material genético estava disperso no citoplasma, sem envoltório nuclear. Essa célula é:","alternativas":["A) eucarionte, como a de uma folha.","B) eucarionte, como a de um fungo.","C) procarionte, como a de uma bactéria.","D) procarionte, como a da pele humana."],"gabarito":"C"}},"6º ANO|3|Reconhecer como o desenvolvimento do microscópio contribuiu para os avanços no conhecimento celular.":{"serie":"6","bim":"3","desc":"Reconhecer como o desenvolvimento do microscópio contribuiu para os avanços no conhecimento celular.","hab":"EF06CI05","habTxt":"Analisar a organização básica da célula como unidade estrutural e funcional de seres uni e pluricelulares (AE5).","nome":"Lupa de gota d'água","concreta":"Pingar uma gota d'água sobre plástico transparente em cima do jornal e ver as letras aumentarem (a gota funciona como lente). Comparar com imagens da cortiça de Hooke (1665) e dos 'animálculos' de Leeuwenhoek.","ab":"Montar linha do tempo com 4 cartões (olho nu → lente simples → microscópios de Hooke e Leeuwenhoek → microscópio moderno), colando a descoberta de cada etapa.","b":"Ler texto curto sobre Hooke e Leeuwenhoek e responder itens relacionando o aumento das lentes às descobertas (células, microrganismos) e à ciência como construção coletiva.","item":{"enunciado":"Em 1665, Robert Hooke observou uma fina fatia de cortiça em um microscópio e viu pequenas cavidades, que chamou de 'células'. Essa descoberta foi possível porque:","alternativas":["A) o microscópio ampliou estruturas muito pequenas, invisíveis a olho nu.","B) as células podem ser vistas facilmente a olho nu.","C) a cortiça é formada por uma única célula gigante.","D) Hooke usou um telescópio para observar a cortiça."],"gabarito":"A"}},"6º ANO|3|Reconhecer os principais componentes celulares (membrana, citoplasma e núcleo).":{"serie":"6","bim":"3","desc":"Reconhecer os principais componentes celulares (membrana, citoplasma e núcleo).","hab":"EF06CI05","habTxt":"Analisar a organização básica da célula como unidade estrutural e funcional de seres uni e pluricelulares (AE5).","nome":"Célula no saquinho","concreta":"Cada grupo monta a célula: saquinho = membrana, água com cola = citoplasma, bolinha = núcleo. Depois compara o modelo com imagens de células de cebola e da bochecha ao microscópio, apontando cada parte.","ab":"Jogo de cartões estrutura↔função (membrana: controla entrada e saída; citoplasma: onde ocorrem reações; núcleo: guarda o material genético) e rotular um desenho de célula.","b":"Analogia célula–escola em duplas (portão, pátio, diretoria), apontando um limite da analogia, e itens com justificativa das alternativas.","item":{"enunciado":"Um aluno montou um modelo de célula com um saquinho plástico, água com cola e uma bolinha. O saquinho representa a estrutura que envolve a célula e controla a entrada e a saída de substâncias. Essa estrutura é:","alternativas":["A) o núcleo.","B) o citoplasma.","C) o material genético.","D) a membrana plasmática."],"gabarito":"D"}},"6º ANO|3|Relacionar as estruturas das organelas celulares às suas funções, considerando as especificidades das células animal e vegetal.":{"serie":"6","bim":"3","desc":"Relacionar as estruturas das organelas celulares às suas funções, considerando as especificidades das células animal e vegetal.","hab":"EF06CI05","habTxt":"Analisar a organização básica da célula como unidade estrutural e funcional de seres uni e pluricelulares (AE5).","nome":"Duas células, uma caixa","concreta":"Montar a célula animal no saquinho e a vegetal no saquinho dentro da caixinha (parede celular), com ervilhas (cloroplastos) e saquinho com água (vacúolo); feijões (mitocôndrias) entram nas duas.","ab":"Tabela guiada marcando X se a estrutura está na célula animal, vegetal ou nas duas e cartões organela↔função (cloroplasto: fotossíntese; mitocôndria: energia; vacúolo: água; parede: sustentação).","b":"Situações-problema em duplas (por que a célula vegetal tem formato mais fixo? onde há mais cloroplastos: folha ou raiz?) e itens com justificativa.","item":{"enunciado":"Ao microscópio, um estudante viu uma célula de formato retangular, envolvida por parede celular e com várias estruturas verdes no citoplasma. Essas estruturas verdes e sua função são:","alternativas":["A) mitocôndrias; produzir energia pela respiração celular.","B) cloroplastos; realizar a fotossíntese.","C) núcleos; controlar a célula.","D) vacúolos; armazenar água."],"gabarito":"B"}},"6º ANO|2|Analisar o processo de fossilização ao longo da história geológica da Terra.":{"serie":"6","bim":"2","desc":"Analisar o processo de fossilização ao longo da história geológica da Terra.","hab":"EF06CI12","habTxt":"Classificar rochas, seus processos de formação e a formação/transformação do solo, incluindo a fossilização em rochas sedimentares (AE3).","nome":"Fóssil de massinha","concreta":"Pressionar concha ou folha na massinha e retirar, formando um molde, como uma impressão fóssil. Depois montar no pote camadas de areia e terra com 'fósseis' de papel: as camadas de baixo se depositaram antes, logo são mais antigas.","ab":"Ordenar 4 quadrinhos da fossilização (ser vivo morre → é coberto por sedimentos → partes duras se mineralizam → erosão expõe o fóssil) com legenda guiada.","b":"Analisar perfil desenhado de camadas com fósseis (peixe embaixo, réptil terrestre em cima), inferir idade relativa e ambiente antigo; itens com justificativa.","item":{"enunciado":"Em um paredão de rochas sedimentares, pesquisadores encontraram fósseis de peixes em uma camada inferior e fósseis de répteis terrestres em uma camada superior. É correto concluir que:","alternativas":["A) os répteis são mais antigos que os peixes encontrados.","B) os peixes viveram antes dos répteis encontrados e a região já foi coberta por água.","C) as duas camadas se formaram no mesmo dia.","D) fósseis só se formam em rochas magmáticas."],"gabarito":"B"}},"6º ANO|3|Classificar seres vivos (bactérias, fungos e/ou protozoários) a partir de suas características celulares e papéis ecossistêmicos.":{"serie":"6","bim":"3","desc":"Classificar seres vivos (bactérias, fungos e/ou protozoários) a partir de suas características celulares e papéis ecossistêmicos.","hab":"EF06CI05","habTxt":"Analisar a organização básica da célula como unidade estrutural e funcional de seres uni e pluricelulares (AE5).","nome":"Mesa dos microrganismos","concreta":"Mesa de observação com pão mofado no saquinho fechado, cogumelo, fermento, iogurte e imagens de bactérias e protozoários. Para cada um a turma pergunta: uma célula ou muitas? Tem núcleo? Que papel tem no ambiente?","ab":"Classificar fichas em tabela de 3 colunas (bactéria: unicelular sem núcleo; fungo: com núcleo, decompositor; protozoário: unicelular com núcleo), com mediação.","b":"Situações-problema: papel do bolor na decomposição, bactérias no iogurte, ameba e a amebíase; itens em duplas justificando as alternativas.","item":{"enunciado":"O bolor que aparece em um pão velho é formado por filamentos de células com núcleo organizado e se alimenta decompondo a matéria orgânica. Esse ser vivo pertence ao grupo dos:","alternativas":["A) bactérias.","B) protozoários.","C) vírus.","D) fungos."],"gabarito":"D"}},"6º ANO|2|Reconhecer as esferas que estruturam a Terra (litosfera, hidrosfera, atmosfera e biosfera), considerando suas funções e características essenciais na dinâmica do planeta.":{"serie":"6","bim":"2","desc":"Reconhecer as esferas que estruturam a Terra (litosfera, hidrosfera, atmosfera e biosfera), considerando suas funções e características essenciais na dinâmica do planeta.","hab":"EF06CI11","habTxt":"Descrever as esferas da Terra (litosfera, hidrosfera, atmosfera, biosfera), o surgimento da litosfera e suas transformações no tempo (AE1).","nome":"Terra no pote","concreta":"Montar a 'Terra no pote': pedrinhas e terra (litosfera), água (hidrosfera), ar fechado em cima (atmosfera) e muda (biosfera); colar etiquetas e discutir como a água passa de uma esfera para outra.","ab":"Classificar 8 imagens (vulcão, rio, nuvem, floresta, montanha, oceano, vento, peixe) em tabela das 4 esferas e completar frase-modelo da função de cada.","b":"Montar mapa conceitual de interações entre esferas (chuva desgastando rochas, plantas liberando oxigênio) e resolver itens com justificativa.","item":{"enunciado":"Um rio que nasce nas montanhas transporta areia e pequenas pedras até o mar, modificando o relevo ao longo do tempo. Nessa situação, ocorre interação principalmente entre:","alternativas":["A) atmosfera e biosfera.","B) biosfera e hidrosfera apenas.","C) hidrosfera e litosfera.","D) atmosfera e litosfera apenas."],"gabarito":"C"}},"6º ANO|2|Reconhecer os principais estados físicos da matéria (sólido, líquido, gasoso) e suas mudanças de estado.":{"serie":"6","bim":"2","desc":"Reconhecer os principais estados físicos da matéria (sólido, líquido, gasoso) e suas mudanças de estado.","hab":"EF06CI01","habTxt":"Classificar substâncias e misturas, analisar métodos de separação e mudanças de estado físico da matéria (AE4).","nome":"Gelo que viaja","concreta":"Observar gelo derretendo no saquinho (fusão), gotinhas surgindo por fora do copo gelado (condensação) e a mancha de pano úmido sumindo da lousa (evaporação); combinar levar o saquinho ao congelador (solidificação).","ab":"Completar esquema circular sólido–líquido–gasoso, nomeando fusão, solidificação, evaporação e condensação com banco de palavras e figuras.","b":"Ler gráfico temperatura × tempo do aquecimento do gelo (patamares em 0 °C e 100 °C) e relacionar ao ciclo da água; itens com justificativa.","item":{"enunciado":"Em um dia quente, Ana tirou da geladeira uma garrafa de água gelada. Depois de alguns minutos, a parte de fora da garrafa ficou molhada. As gotas surgiram porque:","alternativas":["A) o vapor de água do ar se condensou ao tocar a superfície fria.","B) a água atravessou o plástico da garrafa.","C) o gelo de dentro da garrafa evaporou.","D) o ar ao redor da garrafa se solidificou."],"gabarito":"A"}},"6º ANO|3|Associar células, tecidos, órgãos e sistemas aos níveis de organização dos seres vivos.":{"serie":"6","bim":"3","desc":"Associar células, tecidos, órgãos e sistemas aos níveis de organização dos seres vivos.","hab":"EF06CI06","habTxt":"Analisar a organização de células em tecidos, órgãos e sistemas nos seres multicelulares (AE6).","nome":"Zoom no corpo","concreta":"Encaixar potes de tamanhos diferentes (célula dentro de tecido, dentro de órgão…) e pendurar no varal o 'zoom' do coração: célula muscular → tecido muscular → coração → sistema circulatório → organismo.","ab":"Ordenar os cartões e completar frases 'vários(as) ___ formam um(a) ___', com mediação do professor.","b":"Montar sequências para outros sistemas (neurônio → tecido nervoso → encéfalo → sistema nervoso) e resolver itens identificando o nível de organização.","item":{"enunciado":"O estômago é formado por tecido muscular, tecido epitelial e outros tecidos que trabalham juntos na digestão. Considerando os níveis de organização dos seres vivos, o estômago corresponde ao nível de:","alternativas":["A) órgão.","B) célula.","C) tecido.","D) sistema."],"gabarito":"A"}},"6º ANO|2|Relacionar os impactos das ações humanas à qualidade e à saúde do solo.":{"serie":"6","bim":"2","desc":"Relacionar os impactos das ações humanas à qualidade e à saúde do solo.","hab":"EF06CI12","habTxt":"Classificar rochas, seus processos de formação e a formação/transformação do solo, incluindo a fossilização em rochas sedimentares (AE3).","nome":"Erosão na garrafa","concreta":"Regar igualmente duas garrafas PET deitadas com terra, uma coberta por grama/folhas e outra descoberta, e comparar a água recolhida nos copos: a do solo descoberto sai barrenta, carregando solo (erosão).","ab":"Registrar em tabela guiada o que viu nos dois copos (cor, quantidade de terra) e completar 'Sem vegetação, o solo ___'.","b":"Montar mapa conceitual ação humana → impacto → consequência (desmatamento, lixo, agrotóxicos, queimadas) e propor uma ação de conservação; itens.","item":{"enunciado":"Em um experimento, a água que escorreu de uma garrafa com solo descoberto saiu barrenta, enquanto a de um solo coberto por grama saiu quase limpa. Esse resultado indica que o desmatamento:","alternativas":["A) torna o solo mais fértil.","B) aumenta a erosão, pois deixa o solo desprotegido da chuva.","C) não altera o solo.","D) diminui a quantidade de chuva no local."],"gabarito":"B"}},"7º ANO|1|Reconhecer o funcionamento de máquinas simples, com base no conceito de força e exemplos do cotidiano.":{"serie":"7","bim":"1","desc":"Reconhecer o funcionamento de máquinas simples, com base no conceito de força e exemplos do cotidiano.","hab":"EF07CI01A","habTxt":"Distinguir uso e funcionamento de máquinas simples com base no conceito de força e exemplos cotidianos (AE3).","nome":"Alavanca de régua","concreta":"Equilibrar a régua sobre o lápis (ponto de apoio), colocar 2 moedas numa ponta e testar quantas moedas são necessárias do outro lado ao aproximar ou afastar o lápis da carga: apoio perto da carga = menos força.","ab":"Tabela 'posição do lápis × moedas usadas' e rotular figuras (tesoura, gangorra, abridor, carrinho de mão) com A (apoio), F (força) e R (resistência).","b":"Classificar tesoura e gangorra (interfixas), abridor e carrinho de mão (inter-resistentes) e resolver itens sobre força × distância, justificando as alternativas.","item":{"enunciado":"Um pedreiro usa um carrinho de mão para levar tijolos. A roda é o ponto de apoio, a carga fica no meio e ele aplica força nos cabos. O carrinho de mão é uma máquina simples porque:","alternativas":["A) aumenta a massa dos tijolos.","B) elimina a necessidade de aplicar força.","C) funciona como um plano inclinado.","D) permite erguer a carga aplicando uma força menor que o peso dela."],"gabarito":"D"}},"7º ANO|1|Identificar a composição da atmosfera e os fatores naturais e humanos que a modificam, relacionando-os aos impactos ambientais e na saúde do sistema respiratório humano.":{"serie":"7","bim":"1","desc":"Identificar a composição da atmosfera e os fatores naturais e humanos que a modificam, relacionando-os aos impactos ambientais e na saúde do sistema respiratório humano.","hab":"EF07CI12","habTxt":"Identificar a composição da atmosfera e fatores naturais/humanos que a alteram, com impactos no ambiente e na saúde respiratória (AE2).","nome":"Ar em 100 quadradinhos","concreta":"Pintar na grade 10×10 a composição do ar: 78 quadrados de nitrogênio, 21 de oxigênio e 1 de outros gases (argônio, gás carbônico, vapor); depois colar ao redor os cartões das fontes naturais e humanas que alteram o ar.","ab":"Ligar cada fonte de poluição (fumaça de queimada, escapamento, chaminé) a um efeito no sistema respiratório (tosse, asma, bronquite) com setas guiadas.","b":"Analisar tabela de qualidade do ar (CETESB) e de atendimentos por problemas respiratórios em meses secos e chuvosos; montar cadeia causa–efeito e resolver itens.","item":{"enunciado":"O ar é uma mistura de gases. Em uma cidade, no inverno seco, aumentaram as queimadas e os casos de crianças com crises de asma. A alternativa que relaciona corretamente a composição do ar e esse problema é:","alternativas":["A) o ar é formado principalmente por oxigênio, gás que provoca as crises de asma.","B) as queimadas aumentam o nitrogênio do ar, que é tóxico aos pulmões.","C) o ar é formado principalmente por nitrogênio, e as queimadas lançam fumaça e partículas que irritam o sistema respiratório.","D) as queimadas não alteram o ar, apenas a temperatura."],"gabarito":"C"}},"7º ANO|3|Identificar os componentes e características dos ecossistemas aquáticos.":{"serie":"7","bim":"3","desc":"Identificar os componentes e características dos ecossistemas aquáticos.","hab":"EF07CI07","habTxt":"Caracterizar ecossistemas/biomas brasileiros e impactos de catástrofes naturais ou alterações em seus componentes (AE10).","nome":"Aquário de papel","concreta":"Montar na cartolina um 'aquário' colando cartões de fatores abióticos (luz, água, sal, temperatura, oxigênio, pedras) e bióticos (fitoplâncton, peixes, garça, decompositores) e ligar com barbante a teia alimentar.","ab":"Separar os cartões em tabela biótico/abiótico e montar uma cadeia de 3 elos (fitoplâncton → peixe pequeno → garça) com setas guiadas.","b":"Comparar água doce × marinha em tabela (salinidade, exemplos) e prever o efeito de retirar o fitoplâncton da teia; itens com justificativa.","item":{"enunciado":"Em um lago, o fitoplâncton faz fotossíntese e serve de alimento para pequenos crustáceos, que são comidos por peixes. Se a água ficar muito turva e a luz não chegar ao fitoplâncton, a consequência mais provável é:","alternativas":["A) aumento do fitoplâncton.","B) nenhuma alteração na teia alimentar.","C) aumento imediato do número de peixes.","D) redução do fitoplâncton e, depois, dos animais que dependem dele."],"gabarito":"D"}},"7º ANO|2|Reconhecer as características dos microrganismos e sua importância para o ambiente e para a saúde.":{"serie":"7","bim":"2","desc":"Reconhecer as características dos microrganismos e sua importância para o ambiente e para a saúde.","hab":"EF07CI10A","habTxt":"Explicar características de vírus, bactérias e fungos, as doenças que causam e formas de prevenção (AE8).","nome":"Balão do fermento","concreta":"Colocar na garrafa água morna, 1 colher de açúcar e 1 de fermento, prender a bexiga no gargalo e observar em 10–15 min ela encher com gás carbônico liberado pelas leveduras (fungos) na fermentação.","ab":"Tabela 'antes/depois' com desenho da bexiga e completar: 'O fermento é um ___ vivo que consome ___ e libera ___'; depois classificar imagens em 'útil' ou 'causa doença'.","b":"Preencher quadro doença–agente–transmissão–prevenção (gripe, tuberculose, micose, dengue) e resolver itens justificando as alternativas.","item":{"enunciado":"Ana colocou água morna, açúcar e fermento biológico em uma garrafa e prendeu uma bexiga no gargalo. Depois de alguns minutos, a bexiga encheu. Isso ocorreu porque:","alternativas":["A) fungos do fermento consumiram o açúcar e liberaram gás carbônico.","B) a água morna evaporou e encheu a bexiga.","C) o açúcar reagiu sozinho com o ar.","D) bactérias causadoras de doenças se multiplicaram na água."],"gabarito":"A"}},"7º ANO|2|Reconhecer o conceito de sustentabilidade e sua aplicação nas ações humanas e políticas ambientais.":{"serie":"7","bim":"2","desc":"Reconhecer o conceito de sustentabilidade e sua aplicação nas ações humanas e políticas ambientais.","hab":"EF07CI06","habTxt":"Analisar impactos sociais, econômicos e culturais das inovações tecnológicas e o uso consciente, incluindo sustentabilidade (AE5).","nome":"Tripé que não cai","concreta":"Montar um tripé com 3 lápis presos por elástico (ambiental, social, econômico) e mostrar que sem uma perna ele cai; depois ler cartões (horta escolar, lixo no córrego, cooperativa de reciclagem) e decidir se sustentam o tripé.","ab":"Classificar cartões ilustrados em sustentável/não sustentável e marcar qual pilar cada ação favorece, com mediação.","b":"Em duplas, analisar um problema da escola (desperdício de água ou de merenda) e propor plano de intervenção com ação, responsável e ODS relacionado; itens.","item":{"enunciado":"Uma cooperativa de catadores recolhe materiais recicláveis do bairro, gera renda para as famílias e reduz o lixo enviado ao aterro. Essa ação é considerada sustentável porque:","alternativas":["A) traz benefícios apenas econômicos.","B) aumenta o consumo de recursos naturais.","C) une benefícios ambientais, sociais e econômicos.","D) beneficia só o ambiente, sem efeito social."],"gabarito":"C"}},"7º ANO|1|Relacionar o movimento das placas tectônicas à teoria da deriva continental.":{"serie":"7","bim":"1","desc":"Relacionar o movimento das placas tectônicas à teoria da deriva continental.","hab":"EF07CI16","habTxt":"Investigar a deriva continental relacionando o encaixe das costas do Brasil e da África à tectônica de placas (AE1).","nome":"Quebra-cabeça de Wegener","concreta":"Recortar América do Sul e África do mapa e encaixá-las; pintar onde aparecem fósseis de Mesosaurus e Glossopteris nos dois continentes e verificar que as áreas se completam.","ab":"Colar os continentes encaixados e completar ficha guiada com 2 evidências da deriva continental (formato das costas, fósseis iguais).","b":"Analisar mapa de placas com setas de movimento e relacionar a deriva de Wegener à tectônica de placas (movimento sobre o manto); itens com justificativa.","item":{"enunciado":"Fósseis de Mesosaurus, um pequeno réptil de água doce, foram encontrados no Brasil e na África, hoje separados pelo Oceano Atlântico. Essa evidência apoia a ideia de que:","alternativas":["A) o réptil atravessava o oceano nadando.","B) os continentes já estiveram unidos e se afastaram com o movimento das placas tectônicas.","C) os fósseis foram levados pelo vento.","D) os continentes sempre estiveram na mesma posição."],"gabarito":"B"}},"7º ANO|2|Reconhecer as principais características dos grupos de seres vivos invertebrados e vertebrados e seus papéis ecológicos.":{"serie":"7","bim":"2","desc":"Reconhecer as principais características dos grupos de seres vivos invertebrados e vertebrados e seus papéis ecológicos.","hab":"EF07CI07","habTxt":"Caracterizar ecossistemas brasileiros relacionando fatores bióticos e abióticos à fauna e à flora, com foco na biodiversidade (AE9).","nome":"Chave dos bichos","concreta":"A turma monta na lousa uma chave simples de sim/não ('tem coluna vertebral?', 'tem penas?', 'tem pelos?') e passa cada card por ela; discute o papel ecológico (abelha poliniza, minhoca areja o solo, morcego dispersa sementes).","ab":"Classificar cards em tabela invertebrado/vertebrado com uma característica marcante e ligar cada animal ao seu papel ecológico com setas.","b":"Tabela comparativa de peixes, anfíbios, répteis, aves e mamíferos (esqueleto, respiração, reprodução) e itens com justificativa das alternativas.","item":{"enunciado":"Num jardim, as minhocas cavam túneis que arejam o solo e se alimentam de restos de folhas, devolvendo nutrientes à terra. Sobre a minhoca, é correto afirmar que ela é um:","alternativas":["A) vertebrado decompositor.","B) invertebrado que contribui para a fertilidade do solo.","C) vertebrado polinizador.","D) invertebrado parasita das plantas."],"gabarito":"B"}},"7º ANO|2|Reconhecer o efeito estufa como fenômeno natural e os impactos das ações humanas que o intensificam.":{"serie":"7","bim":"2","desc":"Reconhecer o efeito estufa como fenômeno natural e os impactos das ações humanas que o intensificam.","hab":"EF07CI13A","habTxt":"Identificar o efeito estufa como fenômeno natural e as ações humanas que o intensificam (AE7).","nome":"Estufa no copo","concreta":"Colocar ao sol dois copos com a mesma água, um coberto com saco plástico; após 15 min comparar a temperatura: o coberto retém mais calor. É um modelo de como certos gases da atmosfera retêm calor.","ab":"Completar esquema guiado (Sol → superfície → calor retido pelos gases) com banco de palavras e diferenciar efeito estufa natural (mantém a vida) e intensificado.","b":"Ler gráfico de concentração de CO2 ao longo dos anos, relacionar a fontes humanas e propor alternativas; itens com justificativa.","item":{"enunciado":"O efeito estufa natural mantém a temperatura média da Terra em cerca de 15 °C, permitindo a vida. Sobre esse fenômeno, é correto afirmar que:","alternativas":["A) é sempre prejudicial e deveria ser eliminado.","B) é causado pelo buraco na camada de ozônio.","C) é natural, mas é intensificado pela queima de combustíveis fósseis e pelo desmatamento, que aumentam os gases estufa.","D) depende apenas do vapor de água liberado pelos oceanos."],"gabarito":"C"}},"7º ANO|2|Relacionar os impactos das atividades humanas com as mudanças climáticas globais e seus efeitos socioambientais.":{"serie":"7","bim":"2","desc":"Relacionar os impactos das atividades humanas com as mudanças climáticas globais e seus efeitos socioambientais.","hab":"EF07CI05","habTxt":"Analisar impactos socioambientais de combustíveis fósseis, queimadas e desmatamento (AE6).","nome":"Corrente de causas","concreta":"Montar uma corrente de papel com elos: queima de combustíveis/desmatamento/queimadas → mais gás carbônico → efeito estufa intensificado → aquecimento → eventos extremos → impactos sociais.","ab":"Ordenar 5 imagens da cadeia causal e escrever uma frase por elo com ajuda de um banco de palavras.","b":"Analisar o gráfico de temperatura global e uma notícia de evento extremo; explicar por que populações vulneráveis sofrem mais; itens com justificativa.","item":{"enunciado":"Notícias mostram secas mais longas e chuvas mais intensas em várias regiões do Brasil. Cientistas relacionam esses eventos ao aquecimento global. Uma atividade humana que contribui diretamente para esse problema é:","alternativas":["A) a queima de combustíveis fósseis por veículos e indústrias, que libera gás carbônico.","B) o uso de transporte público e bicicletas.","C) o reflorestamento de áreas degradadas.","D) a geração de energia solar."],"gabarito":"A"}},"7º ANO|1|Avaliar a qualidade do ar e seus efeitos sobre o ambiente e a saúde.":{"serie":"7","bim":"1","desc":"Avaliar a qualidade do ar e seus efeitos sobre o ambiente e a saúde.","hab":"EF07CI12","habTxt":"Identificar a composição da atmosfera e fatores naturais/humanos que a alteram, com impactos no ambiente e na saúde respiratória (AE2).","nome":"Cartão pega-poeira","concreta":"Comparar com lupa cartões com vaselina deixados uma semana antes em locais diferentes (portão perto da rua, pátio, sala), contando pontinhos de partículas em uma grade.","ab":"Contar partículas em 4 quadradinhos de cada cartão, registrar em tabela guiada e pintar a carinha correspondente (ar bom ou ruim).","b":"Interpretar a escala do índice de qualidade do ar (de Boa a Péssima) com o boletim de um dia, indicar efeitos na saúde e ações; itens com justificativa.","item":{"enunciado":"Um boletim classificou a qualidade do ar de um bairro como 'Ruim' em um dia seco, com trânsito intenso e queimadas na região. A recomendação mais adequada para esse dia é:","alternativas":["A) fazer exercícios intensos ao ar livre.","B) queimar o lixo acumulado para limpar o ar.","C) usar mais o carro para evitar caminhar.","D) reduzir esforço físico ao ar livre, principalmente crianças, idosos e pessoas com asma."],"gabarito":"D"}},"7º ANO|3|Analisar os impactos das ações humanas nos biomas brasileiros e suas implicações para a preservação ambiental.":{"serie":"7","bim":"3","desc":"Analisar os impactos das ações humanas nos biomas brasileiros e suas implicações para a preservação ambiental.","hab":"EF07CI07","habTxt":"Caracterizar ecossistemas/biomas brasileiros e impactos de catástrofes naturais ou alterações em seus componentes (AE10).","nome":"Mapa das ameaças","concreta":"Colar no mapa dos biomas ícones de ameaças a partir de cards (desmatamento na Amazônia, queimadas no Cerrado e Pantanal, cidades na Mata Atlântica, desertificação na Caatinga, monoculturas no Pampa) e discutir consequências.","ab":"Ligar cada bioma a uma imagem característica e a uma ameaça, completando tabela guiada bioma–ameaça–consequência.","b":"Estudo de caso de um bioma: identificar causa e consequência do impacto e propor 2 medidas de preservação; itens com justificativa.","item":{"enunciado":"A Mata Atlântica ocupava quase todo o litoral brasileiro e grande parte de São Paulo, mas hoje restam apenas fragmentos da floresta original. A principal causa dessa redução foi:","alternativas":["A) as queimadas naturais provocadas por raios.","B) a expansão das cidades, da agricultura e a exploração de madeira desde a colonização.","C) o clima seco característico da região.","D) a criação de unidades de conservação."],"gabarito":"B"}},"7º ANO|1|Reconhecer fenômenos geológicos (vulcanismo, terremotos e tsunamis) e seus impactos na superfície da Terra.":{"serie":"7","bim":"1","desc":"Reconhecer fenômenos geológicos (vulcanismo, terremotos e tsunamis) e seus impactos na superfície da Terra.","hab":"EF07CI15, EF07CI16","habTxt":"Investigar a deriva continental relacionando o encaixe das costas do Brasil e da África à tectônica de placas (AE1).","nome":"Terremoto na bandeja","concreta":"Construir 'prédios' de palitos e caixinhas sobre a bandeja com areia e sacudi-la simulando ondas sísmicas; depois sobrepor o mapa de vulcões e terremotos ao mapa dos limites das placas.","ab":"Pintar no mapa os pontos de terremotos e vulcões, circular onde coincidem com bordas de placas e completar: 'Vulcões e terremotos ocorrem mais ___'.","b":"Ler notícia curta do tsunami no Japão (2011) e responder: causa, impactos e por que o Brasil tem poucos tremores fortes; itens com justificativa.","item":{"enunciado":"O Brasil quase não registra terremotos fortes nem vulcões ativos, ao contrário do Chile e do Japão. Isso se explica porque o Brasil:","alternativas":["A) não está sobre nenhuma placa tectônica.","B) tem clima tropical, que impede terremotos.","C) está no interior da Placa Sul-Americana, longe dos seus limites.","D) tem florestas que absorvem os tremores."],"gabarito":"C"}},"7º ANO|3|Diferenciar Unidades de Conservação de proteção integral e de uso sustentável com base em seus objetivos e formas de uso.":{"serie":"7","bim":"3","desc":"Diferenciar Unidades de Conservação de proteção integral e de uso sustentável com base em seus objetivos e formas de uso.","hab":"EF07CI07","habTxt":"Caracterizar ecossistemas/biomas brasileiros e impactos de catástrofes naturais ou alterações em seus componentes (AE10).","nome":"Parque ou reserva?","concreta":"O professor mostra fotos do Parque Estadual da Serra do Mar (proteção integral) e da APA Cananéia-Iguape-Peruíbe (uso sustentável); para cada card de atividade, a turma decide em qual delas ela é permitida.","ab":"Tabela guiada de 2 colunas com ícones (proteção integral: uso indireto — pesquisa, visitação, educação; uso sustentável: uso direto controlado — pesca, extrativismo, moradia) para colar os cards.","b":"Situações-problema (ex.: comunidade caiçara quer continuar pescando na área) para escolher a categoria de UC e justificar; itens SARESP.","item":{"enunciado":"Uma comunidade tradicional vive da coleta de castanhas e da pesca artesanal em uma floresta que o governo quer proteger. A categoria de Unidade de Conservação mais adequada, que conserva a natureza permitindo o uso controlado dos recursos, é:","alternativas":["A) uso sustentável, como uma Reserva Extrativista.","B) proteção integral, como uma Estação Ecológica.","C) proteção integral, como uma Reserva Biológica.","D) nenhuma, pois em UCs não pode haver pessoas."],"gabarito":"A"}},"8º ANO|3|Analisar os efeitos do aquecimento global no planeta.":{"serie":"8","bim":"3","desc":"Analisar os efeitos do aquecimento global no planeta.","hab":"EF08CI16","habTxt":"Discutir iniciativas para mitigar alterações climáticas causadas por ações humanas e restabelecer o equilíbrio ambiental (AE10).","nome":"Estufa no pote","concreta":"Os dois potes com termômetro ficam ao sol; só um é coberto com filme plástico. A turma lê as temperaturas a cada 5 min. O filme retém o calor, como os gases de efeito estufa (CO₂) retêm calor na atmosfera.","ab":"Completam tabela guiada (tempo × temperatura dos dois potes) e ligam cartões com imagens de efeitos: gelo derretendo, mar subindo, seca, enchente.","b":"Fazem gráfico de linhas com os dados, comparam com um gráfico de CO₂ × temperatura média global e propõem, em dupla com monitor, 2 ações de mitigação na escola/bairro.","item":{"enunciado":"Um gráfico mostra que, de 1960 a 2020, a concentração de CO₂ na atmosfera e a temperatura média global aumentaram juntas. Uma consequência esperada da continuidade desse aumento é","alternativas":["A) o aumento da camada de gelo nos polos.","B) a diminuição de eventos climáticos extremos.","C) a elevação do nível médio dos oceanos.","D) a redução da temperatura dos oceanos."],"gabarito":"C"}},"8º ANO|2|Reconhecer os órgãos do sistema respiratório e suas funções no processo de inspiração e expiração.":{"serie":"8","bim":"2","desc":"Reconhecer os órgãos do sistema respiratório e suas funções no processo de inspiração e expiração.","hab":"EF05CI06B, EF08CI08B","habTxt":"Explicar o funcionamento do sistema respiratório e fatores que o comprometem, como poluição e doenças (AE6).","nome":"Pulmão de garrafa","concreta":"O professor monta o modelo (garrafa = caixa torácica, bexiga de baixo = diafragma, bexiga de dentro = pulmão). Ao puxar o diafragma, o balão enche (inspiração); ao soltar, esvazia (expiração).","ab":"Numeram cartões do caminho do ar (nariz, faringe, laringe, traqueia, brônquios, pulmões/alvéolos) em uma figura e ligam cada órgão à sua função.","b":"Medem respirações por minuto em repouso e após 1 min de polichinelo, montam tabela e explicam em dupla, com o monitor, por que a frequência aumenta.","item":{"enunciado":"Em um modelo feito com garrafa PET e balões, ao puxar a bexiga presa no fundo da garrafa, o balão interno se enche de ar. Esse movimento representa","alternativas":["A) a expiração, pois o diafragma relaxa e sobe.","B) a inspiração, pois o diafragma contrai, desce e aumenta o volume da caixa torácica.","C) a digestão, pois o ar é levado ao estômago.","D) a expiração, pois o volume da caixa torácica diminui."],"gabarito":"B"}},"8º ANO|2|Identificar os órgãos do sistema digestório e sua função na digestão e absorção dos nutrientes.":{"serie":"8","bim":"2","desc":"Identificar os órgãos do sistema digestório e sua função na digestão e absorção dos nutrientes.","hab":"EF05CI06A, EF08CI08B","habTxt":"Descrever estruturas e funções do sistema digestório e dos nutrientes, relacionando à classificação dos alimentos (in natura, processados, ultraprocessados) (AE5).","nome":"Viagem do lanche","concreta":"Simulação: amassar pão com água no saquinho (boca/estômago, digestão mecânica) e passar a pasta pela meia-calça (intestino), mostrando que só partes pequenas atravessam, como na absorção.","ab":"Ordenam cartões do caminho do alimento (boca, faringe, esôfago, estômago, intestino delgado, intestino grosso, ânus) e colam a função de cada um com ajuda do professor.","b":"Resolvem situação-problema sobre uma pessoa sem parte do intestino delgado, explicando o efeito na absorção, e justificam alternativas de 2 itens com o monitor.","item":{"enunciado":"Durante um lanche, o pão começa a ser digerido na boca pela saliva e, depois de passar pelo estômago, seus nutrientes chegam ao sangue. O órgão onde ocorre a maior parte dessa absorção é o","alternativas":["A) esôfago.","B) intestino grosso.","C) fígado.","D) intestino delgado."],"gabarito":"D"}},"8º ANO|3|Relacionar os movimentos da Lua com sua dinâmica em relação à Terra.":{"serie":"8","bim":"3","desc":"Relacionar os movimentos da Lua com sua dinâmica em relação à Terra.","hab":"EF08CI12","habTxt":"Explicar fenômenos astronômicos cíclicos pelos movimentos de Sol, Terra e Lua e pela inclinação do eixo terrestre (AE8).","nome":"A Lua que não vira as costas","concreta":"Um aluno (Lua) com um X de papel colado na camiseta dá a volta em outro (Terra) sempre olhando para ele: ele gira 1 vez em torno de si ao completar 1 volta. A lanterna mostra as fases.","ab":"Completam tabela guiada com desenhos das fases (nova, crescente, cheia, minguante) e a posição da Lua em cada uma, com mediação do professor.","b":"Leem um calendário lunar, calculam o intervalo entre duas luas cheias (~29,5 dias) e explicam em dupla por que a face visível é sempre a mesma.","item":{"enunciado":"Um aluno observou a Lua durante um mês e notou que as manchas visíveis eram sempre as mesmas. Isso ocorre porque","alternativas":["A) a Lua não tem movimento de rotação.","B) o período de rotação da Lua é igual ao de translação ao redor da Terra.","C) a Terra não gira em torno de si mesma.","D) a Lua gira mais rápido do que a Terra."],"gabarito":"B"}},"8º ANO|1|Associar as principais ISTs (HPV, Sífilis, HIV/Aids) aos seus sintomas, formas de transmissão e métodos de prevenção.":{"serie":"8","bim":"1","desc":"Associar as principais ISTs (HPV, Sífilis, HIV/Aids) aos seus sintomas, formas de transmissão e métodos de prevenção.","hab":"EF08CI10, EF08CI09","habTxt":"Analisar formas de prevenção de ISTs e da gravidez precoce, reconhecendo práticas de saúde sexual e reprodutiva (AE3).","nome":"Mito ou verdade? ISTs","concreta":"Leitura de cartões (ex.: 'HIV passa por abraço ou talher' – falso; 'vacina do HPV é gratuita no SUS' – verdadeiro) com votação e explicação do professor. Dúvidas vão para a caixa anônima.","ab":"Completam o quadro HPV/sífilis/HIV com cartões-resposta prontos (sintomas, formas de transmissão, prevenção: camisinha, vacina HPV, testagem na UBS).","b":"Analisam situação-problema sobre um caso fictício e indicam qual serviço de saúde procurar e por quê; justificam alternativas de item SARESP com o monitor.","item":{"enunciado":"Uma campanha do SUS convida meninas e meninos de 9 a 14 anos a se vacinarem. A vacina previne a infecção que pode causar verrugas genitais e câncer do colo do útero. Trata-se da vacina contra","alternativas":["A) o HIV.","B) a sífilis.","C) o HPV.","D) a gonorreia."],"gabarito":"C"}},"8º ANO|1|Comparar os processos reprodutivos das plantas.":{"serie":"8","bim":"1","desc":"Comparar os processos reprodutivos das plantas.","hab":"EF08CI07","habTxt":"Comparar reprodução assexuada e sexuada em vegetais e animais com base em mecanismos evolutivos e adaptativos (AE2).","nome":"Flor por dentro","concreta":"Observação de uma flor aberta com lupa (pétalas, estame, pistilo/ovário) e comparação com pinha de pinheiro (semente nua) e tomate (semente dentro do fruto). Um galho é posto na água: reprodução assexuada.","ab":"Colam etiquetas nas partes da flor desenhada e completam tabela guiada: angiosperma (flor e fruto) x gimnosperma (semente sem fruto).","b":"Comparam em tabela reprodução sexuada (flor, polinização, semente) e assexuada (estaquia, brotos), resolvendo situação-problema de um agricultor que quer mudas iguais.","item":{"enunciado":"Um agricultor quer obter muitas mudas idênticas a uma roseira de flores bonitas. Ele corta pedaços do caule e os planta. Esse processo é um exemplo de","alternativas":["A) reprodução sexuada, que aumenta a variabilidade.","B) polinização feita pelo vento.","C) reprodução assexuada, que gera plantas geneticamente iguais.","D) formação de fruto a partir do ovário."],"gabarito":"C"}},"8º ANO|3|Analisar o papel da inclinação do eixo de rotação da Terra em relação à sua órbita na ocorrência das estações do ano.":{"serie":"8","bim":"3","desc":"Analisar o papel da inclinação do eixo de rotação da Terra em relação à sua órbita na ocorrência das estações do ano.","hab":"EF08CI12, EF08CI13","habTxt":"Explicar fenômenos astronômicos cíclicos pelos movimentos de Sol, Terra e Lua e pela inclinação do eixo terrestre (AE8).","nome":"Globo inclinado","concreta":"A bola inclinada dá a volta na lanterna mantendo o palito sempre na mesma direção. A turma observa qual hemisfério recebe luz mais direta em cada posição.","ab":"Pintam em esquema pronto o hemisfério iluminado e completam tabela: posição da Terra × estação no Sul × estação no Norte.","b":"Analisam tabela de distância Terra–Sol (periélio em janeiro) e argumentam, com o monitor, por que a distância não explica as estações; resolvem item com justificativa.","item":{"enunciado":"Em janeiro a Terra está no ponto mais próximo do Sol, mas é inverno no Hemisfério Norte. As estações do ano ocorrem principalmente devido","alternativas":["A) à variação da distância entre a Terra e o Sol.","B) à inclinação do eixo da Terra em relação à sua órbita.","C) ao movimento de rotação da Lua.","D) às mudanças no tamanho do Sol."],"gabarito":"B"}},"8º ANO|3|Diferenciar os eclipses solar e lunar com base nas posições relativas entre Sol, Terra e Lua.":{"serie":"8","bim":"3","desc":"Diferenciar os eclipses solar e lunar com base nas posições relativas entre Sol, Terra e Lua.","hab":"EF08CI12","habTxt":"Explicar fenômenos astronômicos cíclicos pelos movimentos de Sol, Terra e Lua e pela inclinação do eixo terrestre (AE8).","nome":"Quem fica no meio?","concreta":"Com a sala escura, alinha-se lanterna, Lua e Terra (sombra da Lua na Terra = eclipse solar) e depois lanterna, Terra e Lua (Lua entra na sombra da Terra = eclipse lunar).","ab":"Completam esquemas incompletos desenhando a ordem dos astros e pintando a sombra em cada eclipse, com mediação do professor.","b":"Comparam os dois eclipses em tabela (ordem, fase da Lua, quem pode ver) e justificam alternativas de item SARESP com o monitor.","item":{"enunciado":"Em certa noite de lua cheia, a Lua foi ficando escura e avermelhada, pois entrou na sombra de outro astro. Nesse fenômeno, a ordem de alinhamento é","alternativas":["A) Sol – Lua – Terra.","B) Terra – Sol – Lua.","C) Lua – Sol – Terra.","D) Sol – Terra – Lua."],"gabarito":"D"}},"8º ANO|3|Identificar variáveis meteorológicas relacionadas à previsão do tempo e os instrumentos utilizados para medi-las.":{"serie":"8","bim":"3","desc":"Identificar variáveis meteorológicas relacionadas à previsão do tempo e os instrumentos utilizados para medi-las.","hab":"EF08CI14, EF08CI15","habTxt":"Relacionar climas regionais à circulação atmosférica e oceânica e usar variáveis meteorológicas na previsão do tempo (AE9).","nome":"Miniestação do tempo","concreta":"O professor mostra pluviômetro de PET e biruta montados e um termômetro; em grupos, leem uma previsão real identificando temperatura, umidade, chuva, vento e pressão.","ab":"Ligam cartões variável → instrumento (temperatura–termômetro, chuva–pluviômetro, pressão–barômetro, umidade–higrômetro, vento–anemômetro/biruta) e completam tabela.","b":"Interpretam uma tabela de previsão de 5 dias, decidem o melhor dia para um passeio justificando com as variáveis e diferenciam tempo de clima.","item":{"enunciado":"Uma estação meteorológica registrou a pressão atmosférica de uma cidade ao longo do dia para ajudar na previsão do tempo. O instrumento usado para medir essa variável é o","alternativas":["A) barômetro.","B) pluviômetro.","C) anemômetro.","D) higrômetro."],"gabarito":"A"}},"8º ANO|2|Associar os efeitos da poluição atmosférica na saúde do sistema respiratório.":{"serie":"8","bim":"2","desc":"Associar os efeitos da poluição atmosférica na saúde do sistema respiratório.","hab":"EF05CI06B, EF08CI08B","habTxt":"Explicar o funcionamento do sistema respiratório e fatores que o comprometem, como poluição e doenças (AE6).","nome":"Filtro do ar","concreta":"Coladas fitas adesivas em locais da escola (janela da rua, pátio, sala), coletadas na aula e observadas com lupa sobre papel branco: a sujeira mostra partículas no ar que respiramos.","ab":"Comparam as fitas e completam tabela guiada: local × quantidade de sujeira; ligam imagens de poluentes (fumaça de carro, queimada) a efeitos (tosse, asma, bronquite).","b":"Analisam gráfico de poluição e internações respiratórias, descrevem a relação e propõem medidas individuais e coletivas com o monitor.","item":{"enunciado":"Um gráfico mostra que, nos meses de inverno, aumentam a concentração de material particulado no ar e as internações de crianças por asma. Uma conclusão adequada é que","alternativas":["A) a poluição do ar pode agravar doenças respiratórias.","B) a asma é causada pelo frio, sem relação com o ar.","C) o material particulado protege os pulmões.","D) as internações diminuem com mais poluição."],"gabarito":"A"}},"8º ANO|3|Relacionar padrões de circulação atmosférica e oceânica aos climas regionais.":{"serie":"8","bim":"3","desc":"Relacionar padrões de circulação atmosférica e oceânica aos climas regionais.","hab":"EF08CI14","habTxt":"Relacionar climas regionais à circulação atmosférica e oceânica e usar variáveis meteorológicas na previsão do tempo (AE9).","nome":"Correntes no copo","concreta":"No copo de água em temperatura ambiente, pinga-se água gelada com corante (desce) e depois água morna com outra cor (sobe): convecção, base da circulação do ar e dos oceanos.","ab":"Desenham as setas do experimento e, num mapa simples do Brasil, ligam massas de ar e correntes (quente/fria) a climas com mediação do professor.","b":"Leem texto curto sobre El Niño (seca no Nordeste, chuva no Sul) e explicam em dupla como o aquecimento do Pacífico altera chuvas no Brasil.","item":{"enunciado":"Em anos de El Niño, as águas do Oceano Pacífico Equatorial ficam mais quentes que o normal. No Brasil, um efeito frequente desse fenômeno é","alternativas":["A) neve em todo o Nordeste.","B) seca no Nordeste e chuvas acima da média no Sul.","C) desaparecimento das estações do ano.","D) fim das correntes oceânicas."],"gabarito":"B"}},"8º ANO|2|Reconhecer a função dos nutrientes no organismo humano.":{"serie":"8","bim":"2","desc":"Reconhecer a função dos nutrientes no organismo humano.","hab":"EF05CI06A, EF08CI08B","habTxt":"Descrever estruturas e funções do sistema digestório e dos nutrientes, relacionando à classificação dos alimentos (in natura, processados, ultraprocessados) (AE5).","nome":"Prato com função","concreta":"Em grupos, os alunos separam figuras de alimentos em 3 montes: energéticos (carboidratos/gorduras), construtores (proteínas) e reguladores (vitaminas, minerais) e leem um rótulo juntos.","ab":"Montam um prato de papel colando figuras de cada grupo e completam tabela guiada nutriente → alimento → função.","b":"Comparam rótulos de 2 produtos (ex.: biscoito e iogurte), calculam qual tem mais açúcar/proteína e justificam escolhas segundo o Guia Alimentar com o monitor.","item":{"enunciado":"Durante a recuperação de uma lesão muscular, um médico recomendou a um adolescente uma dieta com mais leite, ovos e feijão, ricos em nutrientes que ajudam na formação e reparação de tecidos. Esses nutrientes são principalmente","alternativas":["A) carboidratos, com função energética.","B) proteínas, com função construtora.","C) fibras, com função de reserva.","D) gorduras, com função reguladora."],"gabarito":"B"}},"8º ANO|1|Comparar os diferentes tipos de reprodução (assexuada e sexuada) e sua influência no sucesso reprodutivo das espécies.":{"serie":"8","bim":"1","desc":"Comparar os diferentes tipos de reprodução (assexuada e sexuada) e sua influência no sucesso reprodutivo das espécies.","hab":"EF08CI07","habTxt":"Comparar reprodução assexuada e sexuada em vegetais e animais com base em mecanismos evolutivos e adaptativos (AE2).","nome":"Cópias ou misturas?","concreta":"Simulação: assexuada = copiar um copinho com 4 feijões iguais; sexuada = juntar 2 feijões de cada pai sorteados. Compara-se a variedade de filhos e o professor relaciona com mitose e meiose.","ab":"Classificam cartões ilustrados em assexuada ou sexuada e completam tabela guiada (nº de pais, filhos iguais ou diferentes).","b":"Resolvem situação-problema: uma doença atinge uma plantação de bananeiras clonadas; explicam o risco da falta de variabilidade e justificam alternativas com o monitor.","item":{"enunciado":"Uma plantação formada apenas por mudas obtidas de uma única planta foi quase toda destruída por uma praga. Isso ocorreu porque, na reprodução assexuada,","alternativas":["A) há grande variabilidade genética.","B) os descendentes são geneticamente iguais, com pouca variabilidade.","C) sempre participam dois indivíduos.","D) ocorre formação de gametas por meiose."],"gabarito":"B"}},"8º ANO|1|Diferenciar métodos contraceptivos e estratégias de prevenção para a saúde.":{"serie":"8","bim":"1","desc":"Diferenciar métodos contraceptivos e estratégias de prevenção para a saúde.","hab":"EF08CI10, EF08CI09","habTxt":"Analisar formas de prevenção de ISTs e da gravidez precoce, reconhecendo práticas de saúde sexual e reprodutiva (AE3).","nome":"Quadro dos métodos","concreta":"Montagem coletiva de um quadro: método × tipo (barreira, hormonal, dispositivo) × evita gravidez? × previne ISTs? O professor destaca que só a camisinha marca 'sim' nas duas colunas.","ab":"Encaixam os cartões no quadro com mediação e respondem perguntas guiadas de sim/não sobre cada método.","b":"Analisam situações-problema curtas e indicam o método adequado e onde obter orientação gratuita (UBS), justificando alternativas com o monitor.","item":{"enunciado":"Uma campanha de saúde afirma que existe um método contraceptivo que, além de evitar a gravidez, também ajuda a prevenir infecções sexualmente transmissíveis. Esse método é","alternativas":["A) a pílula anticoncepcional.","B) a injeção hormonal.","C) o DIU.","D) a camisinha (preservativo)."],"gabarito":"D"}},"8º ANO|3|Diferenciar os movimentos da Terra (rotação, translação e/ou precessão) com base em suas características e efeitos.":{"serie":"8","bim":"3","desc":"Diferenciar os movimentos da Terra (rotação, translação e/ou precessão) com base em suas características e efeitos.","hab":"EF08CI12, EF08CI13","habTxt":"Explicar fenômenos astronômicos cíclicos pelos movimentos de Sol, Terra e Lua e pela inclinação do eixo terrestre (AE8).","nome":"Gira, roda e bamboleia","concreta":"Com lanterna e bola, mostra-se a rotação (24 h, dia e noite) e a translação (≈365 dias, ano). O pião girando mostra o 'bamboleio' do eixo: a precessão (≈26 mil anos).","ab":"Completam tabela guiada: movimento × duração × efeito, usando cartões-resposta, e associam desenhos a cada movimento.","b":"Resolvem questões de associação movimento ↔ fenômeno e explicam com o monitor por que a precessão muda a 'estrela polar' ao longo de milhares de anos.","item":{"enunciado":"Um estudante viajou e percebeu que, quando era meio-dia no Brasil, era noite no Japão. Esse fato é explicado pelo movimento de","alternativas":["A) translação, que dura cerca de 365 dias.","B) precessão, que dura cerca de 26 mil anos.","C) rotação, que dura cerca de 24 horas.","D) translação da Lua ao redor da Terra."],"gabarito":"C"}},"9º ANO|1|Identificar substâncias, misturas e transformações da matéria.":{"serie":"9","bim":"1","desc":"Identificar substâncias, misturas e transformações da matéria.","hab":"EF09CI01","habTxt":"Explicar mudanças de estado físico pela estrutura molecular, organização da matéria e temperaturas de fusão e ebulição (AE3).","nome":"Mistura ou substância?","concreta":"Copos com água, água+sal, água+óleo e água+areia: a turma observa as fases. Depois compara dissolver sal (transformação física) com vinagre+bicarbonato, que forma gás (transformação química).","ab":"Completam tabela guiada: copo × nº de fases × homogênea/heterogênea × método de separação (decantação, filtração, evaporação) com cartões-resposta.","b":"Classificam situações do cotidiano em transformação física ou química pelas evidências (gás, cor, calor) e justificam alternativas de item SARESP com o monitor.","item":{"enunciado":"Em uma aula, ao misturar vinagre e bicarbonato de sódio, os alunos observaram a formação de bolhas. Já ao misturar sal e água, o sal desapareceu sem bolhas. É correto afirmar que","alternativas":["A) os dois casos são transformações químicas.","B) a mistura de sal e água forma uma nova substância.","C) a formação de gás indica uma transformação química.","D) vinagre e bicarbonato formam mistura heterogênea sem reação."],"gabarito":"C"}},"9º ANO|3|Relacionar a evolução biológica à formação da biodiversidade ao longo do tempo.":{"serie":"9","bim":"3","desc":"Relacionar a evolução biológica à formação da biodiversidade ao longo do tempo.","hab":"EF09CI11, EF09CI10","habTxt":"Analisar a evolução e a diversidade das espécies a partir de evidências científicas e processos evolutivos (AE10).","nome":"Jogo dos bicos","concreta":"Grupos usam 'bicos' (pregador, colher ou pinça) para pegar grãos por 30 s, em 3 rodadas, e anotam quantos pegaram. Os bicos que pegam pouco 'não sobrevivem'.","ab":"Registram em tabela guiada bico × grãos coletados e completam frase: 'O bico mais adequado ao alimento sobreviveu e deixou mais descendentes'.","b":"Fazem gráfico de barras com os dados, explicam a seleção natural e relacionam com a diversidade dos tentilhões de Galápagos com o monitor.","item":{"enunciado":"Nas ilhas Galápagos, tentilhões com bicos grossos predominam onde há sementes duras, e com bicos finos onde há insetos. Segundo Darwin, essa diversidade resulta","alternativas":["A) da vontade das aves de mudar o bico.","B) do uso e desuso do bico durante a vida.","C) da seleção natural de variações favoráveis ao ambiente.","D) de todas as aves terem nascido iguais e mudado juntas."],"gabarito":"C"}},"9º ANO|3|Relacionar evidências fósseis à ideia de ancestralidade comum proposta pela teoria da evolução.":{"serie":"9","bim":"3","desc":"Relacionar evidências fósseis à ideia de ancestralidade comum proposta pela teoria da evolução.","hab":"EF09CI11, EF09CI10","habTxt":"Analisar a evolução e a diversidade das espécies a partir de evidências científicas e processos evolutivos (AE10).","nome":"Camadas do tempo","concreta":"No pote, montam-se camadas de terra/areia com uma concha em cada: as camadas de baixo são mais antigas. Depois, a turma observa a sequência de fósseis de ancestrais da baleia com patas.","ab":"Ordenam cartões de fósseis do mais antigo ao mais recente e marcam o que mudou (patas, focinho, nadadeira) com mediação do professor.","b":"Comparam esquemas de membros de vertebrados (homólogos) e explicam em dupla como os fósseis indicam ancestralidade comum; resolvem item justificando.","item":{"enunciado":"Fósseis encontrados em rochas mostram animais que tinham patas e viviam perto da água, com características cada vez mais parecidas com as das baleias atuais. Esses fósseis são evidência de que","alternativas":["A) as baleias sempre existiram como são hoje.","B) as baleias e esses animais têm um ancestral comum.","C) os fósseis não têm relação com seres atuais.","D) as camadas superiores são as mais antigas."],"gabarito":"B"}},"9º ANO|1|Aplicar as Leis Ponderais em reações químicas.":{"serie":"9","bim":"1","desc":"Aplicar as Leis Ponderais em reações químicas.","hab":"EF09CI02","habTxt":"Analisar transformações químicas e relações entre reagentes e produtos aplicando as leis ponderais (AE4).","nome":"A massa sumiu?","concreta":"Pouco bicarbonato vai no balão e o vinagre na garrafa; pesa-se tudo, vira-se o balão e pesa-se de novo: em sistema fechado a massa se conserva (Lavoisier). Repetir aberto mostra perda do gás.","ab":"Completam tabela guiada de massas antes/depois e frases com lacunas sobre a Lei de Lavoisier, com mediação do professor.","b":"Resolvem problemas de proporção (ex.: 2 g de hidrogênio + 16 g de oxigênio → 18 g de água; com 4 g de H, quanto O?) aplicando Proust, com o monitor.","item":{"enunciado":"Na formação da água, 2 g de hidrogênio reagem totalmente com 16 g de oxigênio. Segundo a Lei de Proust, para reagir totalmente com 4 g de hidrogênio são necessários","alternativas":["A) 8 g de oxigênio.","B) 16 g de oxigênio.","C) 32 g de oxigênio.","D) 36 g de oxigênio."],"gabarito":"C"}},"9º ANO|1|Identificar os modelos atômicos considerando sua historicidade e pesquisa científica.":{"serie":"9","bim":"1","desc":"Identificar os modelos atômicos considerando sua historicidade e pesquisa científica.","hab":"EF09CI03","habTxt":"Identificar modelos da estrutura da matéria, a evolução histórica dos modelos atômicos e a classificação periódica (AE2).","nome":"Linha do tempo do átomo","concreta":"Grupos montam com massinha: esfera maciça (Dalton), massa com 'passas' (Thomson), núcleo pequeno com elétrons ao redor (Rutherford) e elétrons em camadas (Bohr), e os colocam numa linha do tempo.","ab":"Ligam cartões modelo ↔ cientista ↔ característica e colam na linha do tempo com mediação do professor.","b":"Leem trecho sobre o experimento da lâmina de ouro e explicam em dupla qual evidência derrubou o modelo de Thomson; justificam alternativas de item.","item":{"enunciado":"No experimento de Rutherford, a maioria das partículas atravessou uma fina lâmina de ouro, mas algumas foram desviadas ou refletidas. Essa observação levou à conclusão de que o átomo","alternativas":["A) é uma esfera maciça e indivisível.","B) é uma massa positiva com elétrons incrustados.","C) tem um núcleo pequeno e denso e muito espaço vazio.","D) não possui elétrons."],"gabarito":"C"}},"9º ANO|1|Analisar fenômenos relacionados às ondas mecânicas e eletromagnéticas em situações do cotidiano.":{"serie":"9","bim":"1","desc":"Analisar fenômenos relacionados às ondas mecânicas e eletromagnéticas em situações do cotidiano.","hab":"EF09CI05, EF09CI04","habTxt":"Investigar ondas mecânicas e eletromagnéticas e como esse conhecimento transformou a comunicação humana (AE6).","nome":"Onda na corda e na luz","concreta":"Com a corda/mola, os alunos produzem ondas mecânicas; o lápis no copo d'água parece 'quebrado' (refração) e a lanterna no espelho mostra a reflexão.","ab":"Classificam cartões em ondas mecânicas (precisam de meio) ou eletromagnéticas (propagam-se no vácuo) com mediação e registram o fenômeno visto em cada teste.","b":"Resolvem situação-problema (por que não se ouve som no espaço, mas se vê a luz das estrelas?) e justificam alternativas de item com o monitor.","item":{"enunciado":"Astronautas na Lua conversam por rádio, pois lá não há ar. Isso acontece porque o som é uma onda","alternativas":["A) eletromagnética, que se propaga no vácuo.","B) mecânica, que precisa de um meio material, e o rádio usa ondas eletromagnéticas.","C) mecânica, que se propaga melhor no vácuo.","D) eletromagnética, mais lenta que as ondas de rádio."],"gabarito":"B"}},"9º ANO|3|Analisar a importância do tratamento de água e esgoto para a qualidade ambiental e a saúde humana.":{"serie":"9","bim":"3","desc":"Analisar a importância do tratamento de água e esgoto para a qualidade ambiental e a saúde humana.","hab":"EF09CI13, EF09CI12A, EF09CI12B","habTxt":"Propor iniciativas para problemas ambientais com consumo consciente e uso sustentável de recursos, considerando UCs e bacias hidrográficas (AE11).","nome":"Da torneira ao rio","concreta":"Um copo de água com terra fica parado (decantação) enquanto outro passa pelo filtro de PET (filtração). A turma compara a turbidez; o professor alerta que a água filtrada ainda não é potável sem desinfecção.","ab":"Ordenam cartões das etapas da ETA (coagulação, floculação, decantação, filtração, cloração) num esquema e ligam esgoto sem tratamento a doenças (diarreia, hepatite A).","b":"Analisam tabela de cobertura de esgoto × casos de doenças de veiculação hídrica em municípios e explicam a relação em dupla com o monitor.","item":{"enunciado":"Um município ampliou a coleta e o tratamento de esgoto de 40% para 90% das casas. Nos anos seguintes, espera-se","alternativas":["A) aumento dos casos de diarreia e hepatite A.","B) redução de doenças de veiculação hídrica e melhoria dos rios.","C) aumento da poluição dos rios.","D) nenhuma mudança na saúde da população."],"gabarito":"B"}},"9º ANO|2|Identificar as características e funções da mitose e da meiose nos ciclos celulares.":{"serie":"9","bim":"2","desc":"Identificar as características e funções da mitose e da meiose nos ciclos celulares.","hab":"EF09CI08","habTxt":"Explicar hereditariedade e aplicações da biotecnologia articulando genética clássica e evolução (AE7).","nome":"Divide e conquista","concreta":"Com massinha, a turma modela uma célula com 4 cromossomos: na mitose formam-se 2 células com 4 cada; na meiose, 2 divisões geram 4 células com 2 cada.","ab":"Desenham o resultado das simulações e completam tabela guiada (nº de divisões, células-filhas, cromossomos, onde ocorre) com cartões-resposta.","b":"Resolvem situação-problema: célula humana com 46 cromossomos — quantos terá após mitose e após meiose? Relacionam meiose à variabilidade com o monitor.","item":{"enunciado":"Uma célula humana com 46 cromossomos sofre um tipo de divisão que origina 4 células com 23 cromossomos cada, que vão formar gametas. Esse processo é a","alternativas":["A) mitose, que mantém o número de cromossomos.","B) meiose, que reduz pela metade o número de cromossomos.","C) mitose, que ocorre só na cicatrização.","D) fecundação, que junta dois gametas."],"gabarito":"B"}},"9º ANO|2|Analisar a aplicação da genética e da biotecnologia na sociedade, considerando aspectos éticos, científicos e tecnológicos.":{"serie":"9","bim":"2","desc":"Analisar a aplicação da genética e da biotecnologia na sociedade, considerando aspectos éticos, científicos e tecnológicos.","hab":"EF09CI09, EF09CI08","habTxt":"Explicar a transmissão de características hereditárias pelas ideias de Mendel, usando heredogramas (AE8).","nome":"Tribunal da biotecnologia","concreta":"Grupos leem manchetes e o professor explica transgênico, clonagem e insulina humana produzida por bactérias modificadas; em seguida, cada grupo assume um papel para o debate.","ab":"Preenchem tabela guiada benefício × risco para 2 manchetes, escolhendo entre cartões prontos, com mediação do professor.","b":"Escrevem um parágrafo argumentativo com 2 evidências sobre o uso de transgênicos e, com o monitor, analisam alternativas de item SARESP.","item":{"enunciado":"Hoje, a insulina usada por pessoas com diabetes é produzida por bactérias que receberam o gene humano da insulina. Esse é um exemplo de","alternativas":["A) clonagem de um animal.","B) seleção natural.","C) organismo transgênico usado na saúde.","D) mutação causada por radiação."],"gabarito":"C"}},"9º ANO|1|Relacionar a organização dos átomos aos estados físicos da matéria e suas propriedades.":{"serie":"9","bim":"1","desc":"Relacionar a organização dos átomos aos estados físicos da matéria e suas propriedades.","hab":"EF09CI01","habTxt":"Explicar mudanças de estado físico pela estrutura molecular, organização da matéria e temperaturas de fusão e ebulição (AE3).","nome":"Dança das partículas","concreta":"Bolinhas na caixa: bem juntas e só tremendo (sólido), deslizando (líquido) e espalhadas sacudindo forte (gás). Alunos também 'encenam' as partículas. O gelo derretendo no copo serve de exemplo.","ab":"Desenham partículas em sólido, líquido e gás em quadros guiados e ligam cada estado a forma/volume fixos ou variáveis.","b":"Interpretam o gráfico de aquecimento da água, identificam os patamares (0 °C fusão, 100 °C ebulição) e explicam com o monitor por que a temperatura fica constante.","item":{"enunciado":"Num gráfico de aquecimento da água ao nível do mar, a temperatura fica constante em 100 °C por alguns minutos, mesmo com o fogo aceso. Nesse trecho ocorre","alternativas":["A) a fusão, com partículas ficando mais organizadas.","B) a ebulição, com partículas passando ao estado gasoso.","C) a solidificação da água.","D) a condensação do vapor."],"gabarito":"B"}},"9º ANO|3|Analisar evidências da ocorrência de evolução convergente e divergente em imagens, esquemas ou modelos comparativos de organismos.":{"serie":"9","bim":"3","desc":"Analisar evidências da ocorrência de evolução convergente e divergente em imagens, esquemas ou modelos comparativos de organismos.","hab":"EF09CI11, EF09CI10","habTxt":"Analisar a evolução e a diversidade das espécies a partir de evidências científicas e processos evolutivos (AE10).","nome":"Parecidos, mas nem tanto","concreta":"Observação de pares de imagens: o professor pinta os mesmos ossos (úmero, rádio, ulna) em braço, nadadeira e asa (homólogos/divergência) e compara com asas de inseto e ave (análogos/convergência).","ab":"Pintam os ossos correspondentes nas imagens e classificam pares em 'mesma origem' ou 'mesma função, origem diferente' com mediação.","b":"Classificam pares de organismos em evolução convergente ou divergente e leem cladograma simples localizando o ancestral comum; justificam alternativas com o monitor.","item":{"enunciado":"O tubarão (peixe) e o golfinho (mamífero) têm corpo hidrodinâmico e nadadeiras, embora não sejam parentes próximos. Essa semelhança é exemplo de","alternativas":["A) evolução divergente, com órgãos homólogos.","B) evolução convergente, com estruturas análogas surgidas por adaptação a ambientes semelhantes.","C) especiação por isolamento geográfico.","D) herança de características adquiridas."],"gabarito":"B"}},"9º ANO|3|Reconhecer a especiação como processo de formação de novas espécies a partir do isolamento reprodutivo associado, ou não, ao isolamento geográfico.":{"serie":"9","bim":"3","desc":"Reconhecer a especiação como processo de formação de novas espécies a partir do isolamento reprodutivo associado, ou não, ao isolamento geográfico.","hab":"EF09CI11, EF09CI10","habTxt":"Analisar a evolução e a diversidade das espécies a partir de evidências científicas e processos evolutivos (AE10).","nome":"O rio que separou","concreta":"A turma é uma 'população'; uma fita (rio) a divide em dois grupos. Em cada lado, sorteiam-se feijões que mudam características ao longo de 'gerações'. Ao fim, os grupos estão diferentes demais para se cruzar.","ab":"Ordenam cartões das etapas (população única → barreira → mudanças diferentes → isolamento reprodutivo → novas espécies) com mediação do professor.","b":"Analisam o caso dos esquilos do Grand Canyon (especiação em andamento) e explicam, com o monitor, o papel do isolamento geográfico e do isolamento reprodutivo na formação de novas espécies.","item":{"enunciado":"Uma população de roedores foi separada por um grande cânion. Após muito tempo, os dois grupos ficaram diferentes e, se reunidos, não geram descendentes férteis. Isso indica que houve","alternativas":["A) apenas isolamento geográfico, sem nova espécie.","B) especiação, com isolamento reprodutivo.","C) convergência evolutiva.","D) reprodução assexuada."],"gabarito":"B"}},"9º ANO|2|Reconhecer a função, composição e estrutura do DNA.":{"serie":"9","bim":"2","desc":"Reconhecer a função, composição e estrutura do DNA.","hab":"EF09CI08","habTxt":"Explicar hereditariedade e aplicações da biotecnologia articulando genética clássica e evolução (AE7).","nome":"Escada do DNA","concreta":"Grupos montam uma 'escada' com tiras: laterais = açúcar e fosfato, degraus = pares de bases (A com T, C com G); ao torcer, obtém-se a dupla-hélice.","ab":"Completam uma fita de DNA com o pareamento correto e ordenam cartões do maior ao menor (célula > núcleo > cromossomo > gene) com mediação.","b":"Escrevem a fita complementar de uma sequência, explicam a função do DNA (guardar a informação genética) e justificam alternativas de item com o monitor.","item":{"enunciado":"Um trecho de uma fita de DNA tem a sequência A T G C C A. Considerando o pareamento das bases, a fita complementar é","alternativas":["A) A T G C C A.","B) T A C G G T.","C) U A C G G U.","D) G C A T T G."],"gabarito":"B"}},"9º ANO|3|Relacionar a gestão e reciclagem de resíduos sólidos às formas de destinação final e ao ciclo de vida dos materiais.":{"serie":"9","bim":"3","desc":"Relacionar a gestão e reciclagem de resíduos sólidos às formas de destinação final e ao ciclo de vida dos materiais.","hab":"EF09CI13, EF09CI12A, EF09CI12B","habTxt":"Propor iniciativas para problemas ambientais com consumo consciente e uso sustentável de recursos, considerando UCs e bacias hidrográficas (AE11).","nome":"Auditoria do lixo","concreta":"De luvas, a turma separa lixo seco limpo em papel, plástico, metal e vidro e discute o ciclo de vida de uma garrafa PET (extração, fabricação, uso, descarte).","ab":"Completam tabela guiada material × destino correto e ordenam cartões do ciclo de vida de um produto com mediação.","b":"Comparam destinos (aterro sanitário, lixão, reciclagem, compostagem) em situação-problema e propõem plano de redução para a escola com o monitor.","item":{"enunciado":"Uma escola separa cascas de frutas e restos de verduras do refeitório. O destino mais adequado para esses resíduos, transformando-os em adubo, é","alternativas":["A) o lixão a céu aberto.","B) a incineração.","C) a compostagem.","D) a reciclagem de plásticos."],"gabarito":"C"}},"9º ANO|2|Aplicar os mecanismos da hereditariedade na explicação da transmissão das características genéticas segundo as Leis de Mendel e outros padrões de dominância.":{"serie":"9","bim":"2","desc":"Aplicar os mecanismos da hereditariedade na explicação da transmissão das características genéticas segundo as Leis de Mendel e outros padrões de dominância.","hab":"EF09CI09","habTxt":"Explicar a transmissão de características hereditárias pelas ideias de Mendel, usando heredogramas (AE8).","nome":"Moeda genética","concreta":"Cada dupla tem 2 'pais' Aa (moedas: cara = A, coroa = a). Lançam as duas moedas 20 vezes, anotam os filhos e comparam com o esperado 1 AA : 2 Aa : 1 aa.","ab":"Preenchem o quadro de Punnett guiado (Aa × Aa) passo a passo e contam quantos filhos têm a característica recessiva.","b":"Resolvem cruzamentos (Aa × aa, dominância incompleta em flores) e interpretam heredograma simples justificando alternativas com o monitor.","item":{"enunciado":"Em ervilhas, a cor amarela (A) é dominante sobre a verde (a). Cruzando duas plantas Aa, a proporção esperada de descendentes verdes é","alternativas":["A) 0%.","B) 25%.","C) 50%.","D) 75%."],"gabarito":"B"}},"9º ANO|3|Analisar os impactos das ações humanas sobre a biodiversidade.":{"serie":"9","bim":"3","desc":"Analisar os impactos das ações humanas sobre a biodiversidade.","hab":"EF09CI13, EF09CI12A, EF09CI12B","habTxt":"Propor iniciativas para problemas ambientais com consumo consciente e uso sustentável de recursos, considerando UCs e bacias hidrográficas (AE11).","nome":"Teia em perigo","concreta":"Alunos seguram cartões e ligam-se com barbante formando uma teia; ao sortear um impacto (ex.: desmatamento), quem é atingido solta o fio e todos veem a teia se desfazer.","ab":"Montam mapa causa → consequência guiado para uma espécie ameaçada (ex.: mico-leão-dourado) com cartões e mediação do professor.","b":"Analisam dados de desmatamento e espécies ameaçadas, relacionam Unidades de Conservação à proteção e justificam alternativas com o monitor.","item":{"enunciado":"O mico-leão-dourado quase foi extinto com a perda da Mata Atlântica. A criação de reservas e corredores florestais ajudou a recuperar sua população. Isso mostra que","alternativas":["A) a fragmentação de habitats favorece as espécies.","B) Unidades de Conservação contribuem para proteger a biodiversidade.","C) espécies invasoras ajudam espécies nativas.","D) o desmatamento não afeta a fauna."],"gabarito":"B"}},"9º ANO|3|Reconhecer o conceito de pegada ecológica como indicador do impacto das atividades humanas sobre o meio ambiente.":{"serie":"9","bim":"3","desc":"Reconhecer o conceito de pegada ecológica como indicador do impacto das atividades humanas sobre o meio ambiente.","hab":"EF09CI13, EF09CI12A, EF09CI12B","habTxt":"Propor iniciativas para problemas ambientais com consumo consciente e uso sustentável de recursos, considerando UCs e bacias hidrográficas (AE11).","nome":"Quanto planeta eu uso?","concreta":"Os alunos respondem questionário simples de hábitos, somam pontos e recortam uma 'pegada' do tamanho correspondente; o professor explica que a pegada estima a área de natureza que cada estilo de vida usa.","ab":"Comparam as pegadas da turma em cartaz e circulam, com ajuda, 2 hábitos que mais aumentaram sua pontuação.","b":"Comparam tabela de pegada ecológica de diferentes países, explicam por que alguns usam mais de um planeta e propõem metas pessoais com o monitor.","item":{"enunciado":"Uma pessoa trocou o carro pela bicicleta, reduziu o consumo de carne e passou a desperdiçar menos energia. Essas mudanças tendem a","alternativas":["A) aumentar sua pegada ecológica.","B) não alterar sua pegada ecológica.","C) reduzir sua pegada ecológica.","D) aumentar o uso de recursos naturais."],"gabarito":"C"}},"9º ANO|3|Identificar iniciativas para enfrentar problemas ambientais, com base no consumo consciente e no uso sustentável dos recursos naturais.":{"serie":"9","bim":"3","desc":"Identificar iniciativas para enfrentar problemas ambientais, com base no consumo consciente e no uso sustentável dos recursos naturais.","hab":"EF09CI13, EF09CI12A, EF09CI12B","habTxt":"Propor iniciativas para problemas ambientais com consumo consciente e uso sustentável de recursos, considerando UCs e bacias hidrográficas (AE11).","nome":"Escola consciente","concreta":"Em grupos, fazem uma ronda rápida pela sala/corredor anotando desperdícios (luz acesa, torneira pingando, lixo misturado) e comparam com cartões de iniciativas reais.","ab":"Ligam cada problema encontrado a uma iniciativa em quadro guiado (problema → ação → recurso economizado) com mediação do professor.","b":"Analisam conta de consumo (antes/depois de uma iniciativa), calculam a economia e propõem um projeto relacionado a um ODS com o monitor.","item":{"enunciado":"Uma escola instalou redutores de vazão nas torneiras e criou campanha para fechar a torneira ao escovar os dentes. Após 3 meses, a conta de água caiu 20%. Essa iniciativa é exemplo de","alternativas":["A) aumento do consumo de recursos.","B) uso sustentável da água.","C) descarte inadequado de resíduos.","D) ação sem efeito ambiental."],"gabarito":"B"}},"9º ANO|2|Analisar os efeitos e aplicações das radiações ionizantes no organismo humano e na área médica.":{"serie":"9","bim":"2","desc":"Analisar os efeitos e aplicações das radiações ionizantes no organismo humano e na área médica.","hab":"EF09CI06, EF09CI07","habTxt":"Classificar radiações eletromagnéticas por frequência e aplicações tecnológicas, reconhecendo implicações para a saúde (AE5).","nome":"Radiação: amiga ou perigo?","concreta":"Observando uma radiografia contra a janela, a turma discute como o raio X atravessa tecidos moles e é barrado pelos ossos; no espectro, destacam-se as radiações ionizantes (UV de alta energia, raios X e gama).","ab":"Classificam cartões em ionizante ou não ionizante e completam tabela guiada uso médico × cuidado de proteção.","b":"Analisam caso de radioterapia (destrói células do tumor, mas pode lesar DNA de células saudáveis) e justificam alternativas de item com o monitor.","item":{"enunciado":"Na radioterapia, radiações ionizantes são direcionadas a tumores para destruir células cancerosas. Os profissionais usam proteção porque essas radiações","alternativas":["A) não têm energia para afetar células.","B) podem danificar o DNA das células.","C) são iguais às ondas de rádio.","D) só atingem objetos metálicos."],"gabarito":"B"}},"9º ANO|3|Relacionar práticas humanas às fontes de poluição da água e às alterações na qualidade dos ambientes aquáticos.":{"serie":"9","bim":"3","desc":"Relacionar práticas humanas às fontes de poluição da água e às alterações na qualidade dos ambientes aquáticos.","hab":"EF09CI13, EF09CI12B","habTxt":"Propor iniciativas para problemas ambientais com consumo consciente e uso sustentável de recursos, considerando UCs e bacias hidrográficas (AE11).","nome":"Investigando o rio","concreta":"Em copos, simulam fontes de poluição (terra = erosão, óleo = descarte doméstico, detergente = esgoto) e observam turbidez, mancha de óleo e espuma contra papel branco.","ab":"Ligam cartões prática humana → poluente → efeito (morte de peixes, água turva) e marcam no mapa da bacia as fontes de poluição com mediação.","b":"Comparam rio com e sem mata ciliar (assoreamento, turbidez) e explicam com o monitor a relação; resolvem item SARESP justificando.","item":{"enunciado":"Moradores observaram que, após a retirada da mata ciliar de um rio, a água ficou mais turva e o rio mais raso. Isso ocorreu principalmente porque","alternativas":["A) a mata ciliar polui a água com folhas.","B) sem vegetação, a terra das margens é levada para o rio, causando assoreamento.","C) os peixes passaram a comer mais.","D) a chuva deixou de cair na região."],"gabarito":"B"}}};
